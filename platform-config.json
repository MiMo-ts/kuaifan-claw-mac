{
  "platforms": {
    "windows": {
      "target": "x86_64-pc-windows-msvc",
      "outputDir": "win",
      "buildCommand": "npm run tauri:build",
      "artifactDir": "src-tauri\\target\\release"
    },
    "macos": {
      "targets": ["aarch64-apple-darwin", "x86_64-apple-darwin", "universal-apple-darwin"],
      "outputDir": "mac",
      "buildCommand": "bash ./build-mac.sh",
      "artifactDir": "src-tauri/target",
      "signingIdentity": "${APPLE_SIGNING_IDENTITY}",
      "entitlements": "src-tauri/entitlements.plist",
      "minimumSystemVersion": "10.15"
    }
  }
}
